# Kraken API credentials (required)
KRAKEN_KEY=your-kraken-api-key
KRAKEN_PASSCODE=your-kraken-secret

# LLM Provider: 'ollama', 'openrouter', 'opencode', or 'cli' (default: ollama)
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
LLM_MODEL=qwen3.5:cloud
OLLAMA_TIMEOUT_MS=180000            # Request timeout in ms (default: 180s, cloud models need more time)

# OpenRouter API (used when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
# LLM_MODEL=x-ai/grok-3-mini-beta

# OpenCode Zen API (used when LLM_PROVIDER=opencode)
# Get your key at https://opencode.ai/auth
# OPENCODE_API_KEY=oc-your-api-key-here
# LLM_MODEL=opencode-go/glm-5.1         # opencode-go models
# LLM_MODEL=opencode/big-pickle         # opencode zen enabled models

# Local coding CLIs (used when LLM_PROVIDER=cli) — NO API KEY REQUIRED.
# Reuses the subscription login of a coding CLI already installed on this
# machine. Install and log in first, e.g.:
#   claude    -> npm i -g @anthropic-ai/claude-code   ; then: claude login       (Claude Pro/Max)
#   codex     -> npm i -g @openai/codex               ; then: codex login        (ChatGPT Plus/Pro)
#   opencode  -> npm i -g opencode-ai                 ; then: opencode auth login
# The bot pipes the same analysis prompt to the CLI over stdin and reads its reply.
# LLM_PROVIDER=cli
# LLM_CLI=claude                        # which CLI to run: claude | codex | opencode
# LLM_MODEL=                            # optional; leave empty to use the CLI's own default model
# LLM_CLI_BIN=                          # optional; override the executable path/name if not on PATH
#
# Shortcut form (instead of LLM_PROVIDER + LLM_CLI):
# LLM_MODEL=cli/claude                  # cli/<name> or cli/<name>/<model>
# LLM_MODEL=cli/opencode/glm-5-1
# LLM_MODEL=cli/codex/gpt-5.5-codex
#
# NOTE: CLI runs draw from your subscription's usage window (shared with your
# interactive Claude/Codex/opencode sessions) and are slower than a raw API call.

# Optional settings
# PORT=8000                           # Web dashboard port
# AI_ENABLED=true                     # Enable/disable AI trading
# ANALYSIS_INTERVAL_MINUTES=30        # How often AI runs analysis
# COUNTRY_CODE=NL                     # ISO 3166-1 alpha-2 country code to filter available trading pairs
# EDIT_PASSWORD=your-secret-password  # Password to edit strategy (required for web edits)
